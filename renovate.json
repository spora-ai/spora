{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "dockerfile"
  ],
  "schedule": [
    "at any time"
  ],
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "dunglas/frankenphp"
      ],
      "versioning": "loose",
      "allowedVersions": "/^1\\.\\d+\\.\\d+-php8\\.5\\.\\d+-bookworm$/",
      "groupName": "the PHP the deployment runs"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "php"
      ],
      "versioning": "loose",
      "allowedVersions": "/^8\\.5\\.\\d+-cli-alpine$/",
      "groupName": "the PHP the deployment runs"
    }
  ]
}
