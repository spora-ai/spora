# Spora environment configuration
#
# Copy this file to .env and fill in the values for your local setup.
# .env takes priority over config.php. Docker/VPS users can skip config.php
# entirely and rely on these env vars (or pass them directly as OS env vars).
#
# Run `make setup` to generate .env automatically with a fresh secret key.

# ── Application ───────────────────────────────────────────────────────────────

# Full public URL of this instance, including port if non-standard (e.g., http://localhost:8082).
# Used for generating email links (verification, password reset) that point back to this app.
# Resolution order — first wins:
#   1. SPOra_APP_URL env var (this setting)
#   2. The web server's HTTP_HOST (request-supplied)
#   3. The web server's SERVER_NAME (Apache ServerName)
#   4. http://localhost (CLI / worker / console / tests)
# REQUIRED behind a reverse proxy that rewrites Host — set this to the public origin.
# Spora does NOT trust X-Forwarded-* headers; those can be spoofed by clients.
# SPORA_APP_URL=http://localhost:8082

# Path prefix Spora is mounted under. The default is /spora because the admin UI
# ships under public/spora/ and plugins ship under public/plugins/<name>/. The host
# root is reserved for operators who develop their own frontend.
# Prepended to email-link paths (verification, password reset) so the links land on
# the actual UI route.
# Leading/trailing slashes are stripped; bare "/" collapses to empty.
# To mount Spora at the host root (e.g. when developing your own frontend),
# set SPOra_APP_PREFIX="" (explicit empty) — leaving the env var unset
# keeps the default /spora.
# SPORA_APP_PREFIX=/spora

# development | production
SPORA_APP_ENV=development

# Allow new users to register via POST /api/v1/auth/register
# Set to false once you have created your account.
SPORA_ALLOW_REGISTRATION=true

# ── Encryption ────────────────────────────────────────────────────────────────

# Base64-encoded 32-byte secret key used to encrypt tool credentials at rest.
# Generate with: php -r "echo base64_encode(random_bytes(32));"
# Never commit this value. Losing it means losing access to encrypted settings.
SPORA_SECRET_KEY=

# Alternative: path to a key file instead of an inline value.
# SPORA_KEY_PATH=/home/user/.spora/secret.key

# ── Database ──────────────────────────────────────────────────────────────────

# sqlite (default, zero-config) | mysql
# SPORA_DB_DRIVER=sqlite
# SQLite path is set in config.php (defaults to storage/database.sqlite).
# SPORA_SQLITE_BUSY_TIMEOUT=5000  # SQLite only (ms) — wait time for locked database

# MySQL / MariaDB — only needed when SPORA_DB_DRIVER=mysql
# SPORA_DB_HOST=127.0.0.1
# SPORA_DB_PORT=3306
# SPORA_DB_NAME=spora
# SPORA_DB_USER=spora
# SPORA_DB_PASSWORD=

# ── Worker ─────────────────────────────────────────────────────────────────────

# server | client — how QUEUED/RUNNING tasks are driven.
#   server = `bin/spora worker:run` drains the queue (daemon or cron).
#            Tasks posted via the API go QUEUED and are picked up on the next
#            worker tick. Default for Docker/VPS/classical-server operators.
#   client = the browser's SharedWorker POSTs /api/v1/tasks/{id}/tick for tasks
#            the user ran, plus /api/v1/worker/housekeeping for scheduled runs
#            and orphan reaping. No daemon required, but a logged-in browser
#            must be open for the queue to drain. Default for cPanel / FTP-only
#            shared hosts without shell access to a long-lived PHP process.
# Unknown values fall back to server. See https://docs.spora-ai.com/deploy/shared-host/client-worker-mode
SPORA_WORKER_RUNTIME_MODE=server

# Lease TTL (seconds) for client-mode ticks. Client-mode only — server-mode
# daemon paths skip the lease and rely on updated_at for orphan detection,
# so this var is read but never consulted in server mode. A healthy tick
# extends the lease at every orchestrator step boundary; the lease only
# lapses when the claimer is presumed dead (browser closed, LLM hung, etc.).
# Set higher than your slowest expected LLM response. Default 600 (10 min).
# See https://docs.spora-ai.com/reference/concepts/worker-deployment
# (and /deploy/shared-host/client-worker-mode#lease-semantics) for the
# full two-window reap model.
# SPORA_TICK_LEASE_SECONDS=600

# Silence window (minutes) before the reaper flips RUNNING → FAILED with
# error_code WORKER_DISCONNECTED. Set higher than your worst-case LLM
# round-trip. In client mode this applies after the lease has expired;
# in server mode (no lease) it applies directly to updated_at. Set to 0
# to disable reaping entirely. Default 60. See link above.
SPORA_WORKER_STALE_MINUTES=60

# Max concurrent child processes in daemon mode (0 = unlimited, spawns a child for every QUEUED task).
SPORA_MAX_WORKERS=0

# ── Timeouts ─────────────────────────────────────────────────────────────────

# Seconds for LLM API calls (reasoning models may need 300+ seconds).
SPORA_LLM_TIMEOUT=300

# Seconds for tool HTTP requests (web search, calendars, etc.).
# Per-tool overrides available as http_timeout on each tool's #[ToolSetting].
SPORA_TOOL_HTTP_TIMEOUT=30

# ── Mercure (Real-time SSE) ───────────────────────────────────────────────────

# Mercure hub URL for real-time task status updates via Server-Sent Events.
# Omit entirely to disable SSE (tasks still work, but the UI won't auto-refresh).
# Example: http://localhost:3000/.well-known/mercure
# SPORA_MERCURE_URL=

# Optional: separate URL the server uses to publish updates (defaults to SPORA_MERCURE_URL).
# Use this when the publish endpoint differs from the subscribe URL (e.g., Docker internal network).
# SPORA_MERCURE_PUBLISH_URL=
# CRITICAL for in-Docker publishers when SERVER_NAME is a public domain:
# do NOT set this to http://localhost/... — Caddy's auto-HTTPS rewrites
# the in-cluster POST and the publisher fails with a TLS alert. Use the
# Docker service name (http://<service-name>:80/...) so Caddy's host
# matcher doesn't apply the auto-HTTPS redirect.

# HS256 shared secret for the Mercure publisher.
# Generate with: php -r "echo bin2hex(random_bytes(32));"
# SPORA_MERCURE_JWT_KEY=

# ── Logging ────────────────────────────────────────────────────────────────────

# debug | info | warning | error
# WARNING is the default. Use debug locally to see all tool dispatch events.
# Do NOT use debug in production — tool arguments (potentially PII) are logged.
SPORA_LOG_LEVEL=warning

# ── Notifications ──────────────────────────────────────────────────────────────

# Send e-mail when a scheduled run completes (requires mail config above).
# Set to true and configure SPORA_MAIL_* to enable.
SPORA_NOTIFICATIONS_EMAIL_ENABLED=false

# Log file path. Defaults to storage/spora.log.
# SPORA_LOG_PATH=/var/log/spora.log