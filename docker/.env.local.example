# Tell Frankenphp, to only bind on localhost:80, don't generate SSL Certs
# Set to your domain in production — Caddy auto-issues Let's Encrypt.
SERVER_NAME=localhost:80

# Spora Docker environment configuration — copy to .env.local for overrides
# .env.local takes priority over .env and config.php

# ── Application ────────────────────────────────────────────────────────────────

SPORA_APP_ENV=development
SPORA_ALLOW_REGISTRATION=true

# ── Encryption ─────────────────────────────────────────────────────────────────

# Base64-encoded 32-byte secret key used to encrypt tool credentials at rest.
# Generate with: php -r "echo base64_encode(random_bytes(32));"
# SPORA_SECRET_KEY=your-base64-key-here

# ── Database ───────────────────────────────────────────────────────────────────

SPORA_DB_DRIVER=mysql
SPORA_DB_HOST=mariadb
SPORA_DB_PORT=3306
SPORA_DB_NAME=spora
SPORA_DB_USER=spora
SPORA_DB_PASSWORD=spora

# ── Worker ──────────────────────────────────────────────────────────────────────

# server | client — runtime mode for QUEUED/RUNNING tasks.
#   server = supervisord runs `bin/spora worker:run` as a long-lived daemon.
#            Matches the default Docker topology (worker process supervised
#            alongside the web server).
#   client = the browser's SharedWorker drives tasks via /api/v1/tasks/{id}/tick.
#            Only flip this if you've removed the worker from supervisord AND
#            confirmed every operator keeps a browser tab open while tasks run.
# See https://docs.spora-ai.com/deploy/shared-host/client-worker-mode
SPORA_WORKER_RUNTIME_MODE=server

# Lease TTL (seconds) for client-mode ticks. Client-mode only — server-mode
# daemon paths skip the lease and rely on updated_at. Set higher than your
# slowest LLM response. Default 600.
# SPORA_TICK_LEASE_SECONDS=600

# Silence window (minutes) before the reaper flips RUNNING → FAILED with
# error_code WORKER_DISCONNECTED. Applies in both modes (after lease
# expiry in client mode, against updated_at in server mode). Set higher
# than your worst-case LLM round-trip. Set to 0 to disable. Default 60.
SPORA_WORKER_STALE_MINUTES=60

# Maximum concurrent workers (0 = unlimited — one child per QUEUED task)
SPORA_MAX_WORKERS=0

# ── Timeouts ───────────────────────────────────────────────────────────────────

# LLM provider request timeout (seconds)
SPORA_LLM_TIMEOUT=300

# HTTP timeout for tool web requests (web search, calendars, etc.)
SPORA_TOOL_HTTP_TIMEOUT=30

# ── Mercure (Real-time SSE via FrankenPHP native) ──────────────────────────────

# FrankenPHP bundles Mercure natively — no separate service needed.
# Omit entirely to disable SSE (UI won't auto-refresh, tasks still work).
# For the default production compose (80:80), the browser opens
# http://localhost/.well-known/mercure over HTTP, or the public
# https://<SERVER_NAME>/.well-known/mercure once TLS is configured.
# For the local-only override (docker compose … -p 8081:80 + SERVER_NAME=localhost:80),
# use http://localhost:8081/.well-known/mercure.
SPORA_MERCURE_URL=http://localhost/.well-known/mercure

# Optional: separate URL the publisher POSTs to (defaults to
# SPORA_MERCURE_URL when unset). Use `http://localhost:80/...` so the
# in-container POST hits the same Caddy vhost the browser uses — the
# `spora:80` form would bake the docker-compose service name into
# the image, which breaks for operators with a different name.
# SPORA_MERCURE_PUBLISH_URL=http://localhost:80/.well-known/mercure

# HS256 shared secret for Mercure JWT signing.
# Generate with: php -r "echo bin2hex(random_bytes(32));"
# Must match the publisher_jwt in frankenphp.conf
SPORA_MERCURE_JWT_KEY=change-me-use-a-long-random-secret-key

# ── Logging ─────────────────────────────────────────────────────────────────────

# debug | info | warning | error
# WARNING is the default. Use debug locally to see all tool dispatch events.
# Do NOT use debug in production — tool arguments (potentially PII) are logged.
SPORA_LOG_LEVEL=debug

# Log file path. Defaults to storage/spora.log.
# Set to "stdout" in Docker — supervisord captures stdout and stderr
# for the web + worker programs, so Monolog records, PHP fatals, and
# error_log() calls all reach `docker logs`. The runtime image pins
# PHP error_log to php://stderr so PHP fatals and uncaught exceptions
# surface in `docker logs` alongside framework logs. Pre-PHP events
# (supervisord startup, image build) aren't covered here.
SPORA_LOG_PATH=stdout

# ── Mail ───────────────────────────────────────────────────────────────────────

# SMTP mail configuration (symfony/mailer)
# SMTP credentials are encrypted at rest and stored in the database when set via UI.
# Use these env vars for Docker/CI environments where no UI is available.
#
# SMTP example (Gmail / compatible):
# SPORA_MAIL_DRIVER=smtp
# SPORA_MAIL_HOST=smtp.gmail.com
# SPORA_MAIL_PORT=587
# SPORA_MAIL_ENCRYPTION=tls
# SPORA_MAIL_USERNAME=your-email@gmail.com
# SPORA_MAIL_PASSWORD=your-app-password
# SPORA_MAIL_FROM=your-email@gmail.com
# SPORA_MAIL_FROM_NAME=Spora

# PHP mail() function (default, no config needed):
# SPORA_MAIL_DRIVER=php_mail

# Log only (dev — writes email metadata to spora.log instead of sending):
SPORA_MAIL_DRIVER=log
